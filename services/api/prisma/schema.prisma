generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum PositionSource {
  GT06
  JIMI
}

enum AlertSource {
  GT06
  JIMI
}

enum AlertStatus {
  NEW
  REVIEWING
  RESOLVED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum ExpenseCategory {
  IPVA
  INSURANCE
  LICENSE
  RENT
  FINANCING
  TRAVEL
  DOCUMENT
  OTHER
}

enum FineStatus {
  PENDING
  PAID
  CONTESTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  vehicles             Vehicle[]
  jimiIntegrations     JimiIntegration[]
  gt06Integrations     Gt06Integration[]
  geofences            Geofence[]
  drivers              Driver[]
  checklistTemplates   ChecklistTemplate[]
  notificationPrefs    NotificationPreference[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(OPERATOR)
  active         Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dashboardLayout DashboardLayout?

  @@index([organizationId])
}

model Driver {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  cpf            String?
  cnh            String?
  rfidTag        String?
  ibuttonId      String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments DriverAssignment[]
  alerts      Alert[]
  positions   Position[]
  fuelEntries FuelEntry[]
  checklists  ChecklistEntry[]
  fines       VehicleFine[]

  @@unique([organizationId, rfidTag])
  @@index([organizationId])
}

model DriverAssignment {
  id        String    @id @default(cuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([driverId, startedAt(sort: Desc)])
  @@index([vehicleId, startedAt(sort: Desc)])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate          String
  label          String
  renavam        String?
  plateState     String?
  ownerDocument  String?
  trackerImei    String?
  cameraDeviceId String?
  cameraModel    String?
  trackerStatus  DeviceStatus @default(UNKNOWN)
  cameraStatus   DeviceStatus @default(UNKNOWN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  positions              Position[]
  alerts                 Alert[]
  videoClips             VideoClip[]
  driverAssignments      DriverAssignment[]
  stopPoints             StopPoint[]
  fuelEntries            FuelEntry[]
  maintenanceOrders      MaintenanceOrder[]
  maintenanceReminders   MaintenanceReminder[]
  checklists             ChecklistEntry[]
  fines                  VehicleFine[]
  expenses               VehicleExpense[]
  liveStreamSessions     LiveStreamSession[]

  @@unique([organizationId, plate])
  @@unique([organizationId, trackerImei])
  @@unique([organizationId, cameraDeviceId])
  @@index([organizationId])
}

model JimiIntegration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Jimi IoT Hub")
  appKey         String?
  appSecret      String?
  pushUrl        String?
  apiBaseUrl     String       @default("https://hk-open.tracksolidpro.com/route/rest")
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Gt06Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Servidor GT06")
  host           String       @default("0.0.0.0")
  port           Int          @default(5023)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Geofence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  latitude       Float
  longitude      Float
  radiusMeters   Int          @default(500)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Position {
  id         String         @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  source     PositionSource
  latitude   Float
  longitude  Float
  speedKmh   Float?
  course     Float?
  ignitionOn Boolean?
  recordedAt DateTime
  createdAt  DateTime       @default(now())

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@index([driverId])
}

model StopPoint {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int      @default(0)

  @@index([vehicleId, startedAt(sort: Desc)])
}

model Alert {
  id        String      @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  source    AlertSource
  type      String
  label     String
  status    AlertStatus @default(NEW)
  severity  String      @default("MEDIUM")
  payload   Json        @default("{}")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  videoClips VideoClip[]

  @@index([createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model VideoClip {
  id         String    @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  alertId    String?
  alert      Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  fileName   String
  fileUrl    String?
  channel    String?
  recordedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([vehicleId, createdAt(sort: Desc)])
}

model LiveStreamSession {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  streamUrl String?
  channel   Int      @default(1)
  startedAt DateTime @default(now())
  expiresAt DateTime

  @@index([vehicleId, startedAt(sort: Desc)])
}

model FuelEntry {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  liters     Float
  amountPaid Float
  odometerKm Float?
  station    String?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt(sort: Desc)])
}

model MaintenanceOrder {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  description String
  partsCost   Float           @default(0)
  laborCost   Float           @default(0)
  odometerKm  Float?
  performedAt DateTime
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([vehicleId, performedAt(sort: Desc)])
}

model MaintenanceReminder {
  id              String    @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  service         String
  intervalKm      Int?
  intervalDays    Int?
  lastDoneAt      DateTime?
  lastDoneKm      Float?
  alertDaysBefore Int       @default(7)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId])
}

model ChecklistTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  items          Json
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entries ChecklistEntry[]

  @@index([organizationId])
}

model ChecklistEntry {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers     Json
  submittedAt DateTime          @default(now())

  @@index([vehicleId, submittedAt(sort: Desc)])
}

model VehicleFine {
  id           String     @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  description  String
  amount       Float
  dueDate      DateTime?
  paidAt       DateTime?
  status       FineStatus @default(PENDING)
  location     String?
  latitude     Float?
  longitude    Float?
  autoImported Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([vehicleId, createdAt(sort: Desc)])
}

model VehicleExpense {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amount      Float
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([vehicleId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String?
  onCritical     Boolean      @default(true)
  onHigh         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model DashboardLayout {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets Json
}

model TrackerSession {
  imei       String   @id
  connected  Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  remoteIp   String?
  ignitionOn Boolean?
  updatedAt  DateTime @updatedAt
}
