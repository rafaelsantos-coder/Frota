generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum PositionSource {
  GT06
  JIMI
}

enum AlertSource {
  GT06
  JIMI
}

enum AlertStatus {
  NEW
  REVIEWING
  RESOLVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  vehicles         Vehicle[]
  jimiIntegrations JimiIntegration[]
  gt06Integrations Gt06Integration[]
  geofences        Geofence[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(OPERATOR)
  active         Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate          String
  label          String
  trackerImei    String?
  cameraDeviceId String?
  cameraModel    String?
  trackerStatus  DeviceStatus @default(UNKNOWN)
  cameraStatus   DeviceStatus @default(UNKNOWN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  positions  Position[]
  alerts     Alert[]
  videoClips VideoClip[]

  @@unique([organizationId, plate])
  @@unique([organizationId, trackerImei])
  @@unique([organizationId, cameraDeviceId])
  @@index([organizationId])
}

model JimiIntegration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Jimi IoT Hub")
  appKey         String?
  appSecret      String?
  pushUrl        String?
  apiBaseUrl     String       @default("https://hk-open.tracksolidpro.com/route/rest")
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Gt06Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String       @default("Servidor GT06")
  host           String       @default("0.0.0.0")
  port           Int          @default(5023)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Geofence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  latitude       Float
  longitude      Float
  radiusMeters   Int          @default(500)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Position {
  id         String         @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source     PositionSource
  latitude   Float
  longitude  Float
  speedKmh   Float?
  course     Float?
  recordedAt DateTime
  createdAt  DateTime       @default(now())

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
}

model Alert {
  id        String      @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  source    AlertSource
  type      String
  label     String
  status    AlertStatus @default(NEW)
  severity  String      @default("MEDIUM")
  payload   Json        @default("{}")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  videoClips VideoClip[]

  @@index([createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([status])
}

model VideoClip {
  id         String    @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  alertId    String?
  alert      Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  fileName   String
  fileUrl    String?
  channel    String?
  recordedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([vehicleId, createdAt(sort: Desc)])
}

model TrackerSession {
  imei       String   @id
  connected  Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  remoteIp   String?
  updatedAt  DateTime @updatedAt
}
