# PostgreSQL (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://frota:frota@localhost:5432/frota

# API
API_PORT=3001
API_HOST=0.0.0.0
PORT=3001
INTERNAL_API_SECRET=change-me-in-production-min-32-chars
JWT_SECRET=change-me-jwt-secret-min-32-chars

# Admin inicial (criado no primeiro boot se não existir usuário)
ADMIN_EMAIL=admin@sulnet.com
ADMIN_PASSWORD=Sulnet@2026
ADMIN_NAME=Administrador

# GT06 ingest
GT06_PORT=5023
GT06_CMD_PORT=5024
GT06_COMMAND_URL=http://localhost:5024/internal/command
GT06_BLOCK_CMD=RELAY,1#
GT06_UNBLOCK_CMD=RELAY,0#
GT06_PUBLIC_HOST=seu-dominio.proxy.rlwy.net
API_INTERNAL_URL=http://localhost:3001

# Telegram (alertas)
TELEGRAM_BOT_TOKEN=

# IA — extração de dados da CNH digital (Gemini recomendado)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Opcional: openai como alternativa
CNH_AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web pública (links de compartilhamento)
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
